{
  "compilerOptions": {
    "module": "preserve",
    "target": "es2024",
    "outDir": "out",
    "moduleResolution": "bundler",
    "lib": ["es2024", "dom"],
    "types": ["node", "vscode", "mocha"],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "sourceMap": true,
    "rootDir": ".",
    "strict": true,
    "alwaysStrict": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitAny": true,
    "strictFunctionTypes": true,
    "strictNullChecks": true,
    "noImplicitThis": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "ts-node": {
    "compilerOptions": {
      "module": "commonjs"
    }
  },
  "exclude": ["node_modules", ".vscode-test", "docs", "vscode-kubernetes-tools", "javascript" ,"spec_example", "topoViewerEditor"]
}
